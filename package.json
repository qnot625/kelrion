{
  "name": "adminops-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*",
    "modules/platform/*",
    "modules/domains/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "vite --host 0.0.0.0 --port 3000 --strictPort false apps/web",
    "build": "npm run build:web && tsc -b",
    "build:web": "npm run build -w @klerion/company-console",
    "typecheck": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "fastify": "^5.11.0",
    "lucide-react": "^1.28.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
