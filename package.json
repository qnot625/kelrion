    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "tsx": "^4.19.2"
  }
}
